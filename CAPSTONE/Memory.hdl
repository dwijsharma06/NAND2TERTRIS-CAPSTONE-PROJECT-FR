
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    Not(in=address[14], out=notA14);
    Not(in=address[13], out=notA13);

    And(a=load, b=notA14, out=loadRAM);

    And(a=address[14], b=notA13, out=screenRegion);
    And(a=load, b=screenRegion, out=loadScreen);

    And(a=address[14], b=address[13], out=isKeyboard);

    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramOut);

    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);

    Keyboard(out=keyboardOut);

    Mux16(a=ramOut, b=screenOut, sel=address[14], out=memoryOut);

    Mux16(a=memoryOut, b=keyboardOut, sel=isKeyboard, out=out);
}
