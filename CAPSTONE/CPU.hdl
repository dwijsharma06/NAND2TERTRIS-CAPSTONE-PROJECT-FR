
CHIP CPU {
    IN inM[16], instruction[16], reset;
    OUT outM[16], writeM, addressM[15], pc[15];

    PARTS:
    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=aIn);
    Or(a=notC, b=loadAFromC, out=loadA);
    Not(in=instruction[15], out=notC);
    And(a=instruction[15], b=instruction[5], out=loadAFromC);
    ARegister(in=aIn, load=loadA, out=aOut);

    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dOut);

    Mux16(a=aOut, b=inM, sel=instruction[12], out=aluY);

    ALU(
        x=dOut,
        y=aluY,
        zx=instruction[11],
        nx=instruction[10],
        zy=instruction[9],
        ny=instruction[8],
        f=instruction[7],
        no=instruction[6],
        out=aluOut,
        zr=zr,
        ng=ng
    );

    And(a=instruction[15], b=instruction[3], out=writeM);
    Or(a=instruction[15], b=false, out=unused);
    Or(a=zr, b=ng, out=notGreater);
    Not(in=notGreater, out=greater);

    And(a=instruction[2], b=ng, out=jumpLT);
    And(a=instruction[1], b=zr, out=jumpEQ);
    And(a=instruction[0], b=greater, out=jumpGT);

    Or(a=jumpLT, b=jumpEQ, out=jump1);
    Or(a=jump1, b=jumpGT, out=jump2);
    And(a=instruction[15], b=jump2, out=pcLoad);

    PC(in=aOut, load=pcLoad, inc=true, reset=reset, out[0..14]=pc);

    Or16(a=aluOut, b=false, out=outM);
    Or16(a=aOut, b=false, out[0..14]=addressM);
}
